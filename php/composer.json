{
    "name": "job-notifier/job-api",
    "description": "Simple PHP REST API for job notifications using Slim Framework",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0",
        "zircote/swagger-php": "^5.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "openapi": "openapi src -o public/openapi.yaml"
    }
}
